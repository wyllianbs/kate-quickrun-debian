          </property>
          <property name="placeholderText">
           <string>kate/2</string>
          </property>
         </widget>
        </item>
        <item row="3" column="0">
         <widget class="QLabel" name="labelTermHeight">
          <property name="text">
           <string>Window Height:</string>
          </property>
         </widget>
        </item>
        <item row="3" column="1">
         <widget class="QLineEdit" name="editTermHeight">
          <property name="toolTip">
           <string>Accepts "kate" (window height), "kate/N" (a fraction of it) or a number of pixels.</string>
          </property>
          <property name="placeholderText">
           <string>kate</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QCheckBox" name="checkEmbedWindow">
        <property name="text">
         <string>Snap the window next to Kate</string>
        </property>
        <property name="toolTip">
         <string>Positions the external window snapped to the chosen edge of the Kate window, via KWin.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="checkFocusExternal">
        <property name="text">
         <string>Focus the external window on open</string>
        </property>
        <property name="toolTip">
         <string>Activates the external terminal window as soon as it appears. Unchecked, focus stays in the editor. Unlike the embedded terminal, here focus is given on open, not on each input.</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
