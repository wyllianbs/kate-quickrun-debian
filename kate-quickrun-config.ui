 <class>KateRunPluginConfigUi</class>
 <widget class="QWidget" name="KateRunPluginConfigUi">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>620</width>
    <height>720</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QGroupBox" name="groupMode">
     <property name="title">
      <string>Run Destination</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayoutMode">
      <item>
       <widget class="QRadioButton" name="radioOwnTerminal">
        <property name="text">
         <string>Quick Run Terminal</string>
        </property>
        <property name="toolTip">
         <string>Terminal dedicated to Quick Run, in its own Kate panel. Does not interfere with the Terminal plugin's shell. Created on the first run and movable to any window edge.</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QRadioButton" name="radioEmbedded">
        <property name="text">
         <string>Kate Terminal</string>
        </property>
        <property name="toolTip">
         <string>Uses the embedded terminal from Kate's Terminal plugin, sharing the same shell.</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QRadioButton" name="radioExternal">
        <property name="text">
         <string>External Terminal</string>
        </property>
        <property name="toolTip">
         <string>Opens a separate terminal window, with the emulator chosen below.</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupQuickRun">
     <property name="title">
      <string>Quick Run Terminal</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayoutQuickRun">
      <item>
       <layout class="QFormLayout" name="formLayoutOwnTerm">
        <item row="0" column="0">
         <widget class="QLabel" name="labelOwnPosition">
          <property name="text">
           <string>Panel Position:</string>
          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QComboBox" name="comboOwnPosition"/>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="labelOwnIcon">
          <property name="text">
           <string>Panel Icon:</string>
          </property>
         </widget>
        </item>
        <item row="1" column="1">
         <layout class="QHBoxLayout" name="horizontalLayoutOwnIcon">
          <item>
           <widget class="KIconButton" name="btnOwnIcon"/>
          </item>
          <item>
           <spacer name="horizontalSpacerOwnIcon">
            <property name="orientation">
             <enum>Qt::Horizontal</enum>
            </property>
            <property name="sizeHint" stdset="0">
             <size>
              <width>40</width>
              <height>20</height>
             </size>
            </property>
           </spacer>
          </item>
         </layout>
        </item>
        <item row="2" column="0">
         <widget class="QLabel" name="labelOwnWidth">
          <property name="text">
           <string>Initial Width (left/right):</string>
          </property>
         </widget>
        </item>
        <item row="2" column="1">
         <widget class="QLineEdit" name="editOwnWidth">
          <property name="toolTip">
           <string>Accepts "kate" (window width), "kate/N" (a fraction of it) or a number of pixels.</string>
          </property>
          <property name="placeholderText">
           <string>kate/2</string>
          </property>
         </widget>
        </item>
        <item row="3" column="0">
         <widget class="QLabel" name="labelOwnHeight">
          <property name="text">
           <string>Initial Height (top/bottom):</string>
          </property>
         </widget>
        </item>
        <item row="3" column="1">
         <widget class="QLineEdit" name="editOwnHeight">
          <property name="toolTip">
           <string>Accepts "kate" (window height), "kate/N" (a fraction of it) or a number of pixels.</string>
          </property>
          <property name="placeholderText">
           <string>kate/3</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QCheckBox" name="checkFocusOnInput">
        <property name="text">
         <string>Focus the terminal when the program waits for user input</string>
        </property>
        <property name="toolTip">
         <string>Applies to the Quick Run Terminal and the Kate Terminal. Focus is only moved while the program is blocked reading the keyboard (C, C++, Python, etc.). Asynchronous runtimes like Node.js do not trigger the detection.</string>
        </property>
        <property name="checked">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupExternal">
     <property name="title">
      <string>External Terminal</string>
